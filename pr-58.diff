+
+    @staticmethod
+    def _bloquear(ordem_servico: OrdemServico) -> OrdemServico:
+        return OrdemServico.objects.select_for_update().get(pk=ordem_servico.pk)
+
+    @staticmethod
+    def _alertar_gestor_reprovacao(ordem_servico: OrdemServico, usuario, justificativa: str | None) -> None:
+        gestor = ordem_servico.gestor
+
+        if gestor is None:
+            registrar_historico(ordem_servico, usuario, "Alerta de reprova├º├úo: OS sem gestor definido; nenhum e-mail enviado.")
+            return
+
+        registrar_historico(ordem_servico, usuario, f"Alerta de reprova├º├úo enviado ao gestor {gestor.nome}.")
+
