+        if usuario_ja_vinculado(ordem_servico, usuario):
+            return False
+
+        if not os_esta_ativa(ordem_servico):
+            raise OrdemServicoInativaError(
+                self.MENSAGEM_OS_INATIVA.format(status=status_para_api(ordem_servico.status_ordem_servico))
