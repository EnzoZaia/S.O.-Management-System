+
+<script setup lang="ts">
+import { ref, computed, onMounted, onBeforeUnmount } from 'vue'
+import { useRouter } from 'vue-router'
+import Swal from 'sweetalert2'
+import ValidacaoServicoModal from '@/components/ValidacaoServicoModal.vue'
+import EstrelasAvaliacao from '@/components/EstrelasAvaliacao.vue'
+import {
+  buscarAvaliacao, buscarHistoricoOrdem, buscarOrdem, buscarValidacao, listarMinhasOrdens, validarOrdem, ValidacaoError,
+} from '@/services/portalService'
+import type {
+  AvaliacaoRegistrada, ErroValidacao, EventoHistorico, FiltroStatusPortal, OrdemPortal, ResultadoValidacao, ValidacaoRegistrada,
+} from '@/types/portal'
+import {
+  acoesPermitidas, extrairProblema, formatarData, formatarDataHora, formatarEvento,
+  infoStatus, nomeTecnico, pertenceAoFiltro, podeAvaliar, podeTerValidacao,
+} from '@/utils/statusOrdem'
+
+const INTERVALO_ATUALIZACAO_MS = 30_000
+
+const router = useRouter()
+const ordens = ref<OrdemPortal[]>([])
+const loading = ref(true)
+const erro = ref('')
+const ultimaAtualizacao = ref('')
+const filtro = ref<FiltroStatusPortal>('TODOS')
+const busca = ref('')
+
+const selecionada = ref<OrdemPortal | null>(null)
+const historico = ref<EventoHistorico[]>([])
+const loadingHistorico = ref(false)
+const erroHistorico = ref('')
+const enviando = ref(false)
+const validando = ref(false)
+const validacao = ref<ValidacaoRegistrada | null>(null)
+const avaliacao = ref<AvaliacaoRegistrada | null>(null)
+let timer: ReturnType<typeof setInterval> | null = null
+
+const filtros: { valor: FiltroStatusPortal; rotulo: string }[] = [
+  { valor: 'TODOS', rotulo: 'Todas' },
+  { valor: 'EM_ANDAMENTO', rotulo: 'Em andamento' },
+  { valor: 'AGUARDANDO_VOCE', rotulo: 'Aguardando valida├º├úo' },
+  { valor: 'FINALIZADAS', rotulo: 'Finalizadas' },
+]
+
+const acoes = computed(() => (selecionada.value ? acoesPermitidas(selecionada.value) : { validar: false, evidencia: false, avaliar: false }))
+
+function contagem(f: FiltroStatusPortal) {
+  return ordens.value.filter((o) => pertenceAoFiltro(o, f)).length
+}
+
+const ordensFiltradas = computed(() => {
+  const termo = busca.value.trim().toLowerCase()
+  return ordens.value.filter((o) => {
+    if (!pertenceAoFiltro(o, filtro.value)) return false
+    if (!termo) return true
+    return (
+      String(o.id_ordem_servico).includes(termo) ||
+      (o.predio_nome || '').toLowerCase().includes(termo) ||
+      (o.localizacao_nome || '').toLowerCase().includes(termo) ||
+      (o.descricao_servico || '').toLowerCase().includes(termo)
+    )
+  })
+})
+
+async function carregar(manual = false) {
+  if (manual) loading.value = true
+  try {
+    ordens.value = await listarMinhasOrdens()
+    erro.value = ''
+    ultimaAtualizacao.value = new Date().toLocaleTimeString('pt-BR', { hour: '2-digit', minute: '2-digit' })
+
+    if (selecionada.value) {
+      const atual = ordens.value.find((o) => o.id_ordem_servico === selecionada.value!.id_ordem_servico)
+      if (atual) {
+        const mudou = atual.status_ordem_servico !== selecionada.value.status_ordem_servico
+        selecionada.value = atual
+        if (mudou) {
+          await Promise.all([
+            carregarHistorico(atual.id_ordem_servico),
+            carregarValidacao(atual),
+            carregarAvaliacao(atual),
+          ])
+        }
+      }
+    }
+  } catch (e) {
+    console.error('Erro ao carregar solicita├º├Áes', e)
+    if (ordens.value.length === 0) erro.value = 'N├úo foi poss├¡vel carregar suas solicita├º├Áes. Tente novamente.'
+  } finally {
+    loading.value = false
+  }
+}
+
+async function carregarHistorico(id: number) {
+  loadingHistorico.value = true
+  erroHistorico.value = ''
+  try {
+    historico.value = await buscarHistoricoOrdem(id)
+  } catch (e) {
+    console.error('Erro ao carregar hist├│rico', e)
+    historico.value = []
+    erroHistorico.value = 'N├úo foi poss├¡vel carregar o hist├│rico.'
+  } finally {
+    loadingHistorico.value = false
+  }
+}
+
+async function abrirDetalhes(os: OrdemPortal) {
+  selecionada.value = os
+  historico.value = []
+  validacao.value = null
+  avaliacao.value = null
+  await Promise.all([carregarHistorico(os.id_ordem_servico), carregarValidacao(os), carregarAvaliacao(os)])
+}
+
+async function carregarValidacao(os: OrdemPortal) {
+  validacao.value = podeTerValidacao(os) ? await buscarValidacao(os.id_ordem_servico) : null
+}
+
+// US08: s├│ busca a avalia├º├úo quando a ordem j├í pode ter uma (CONCLUIDA/ENCERRADA).
+async function carregarAvaliacao(os: OrdemPortal) {
+  avaliacao.value = acoesPermitidas(os).avaliar ? await buscarAvaliacao(os.id_ordem_servico) : null
+}
+
+function fecharDetalhes() {
+  selecionada.value = null
+  historico.value = []
+  validacao.value = null
+  avaliacao.value = null
+  validando.value = false
+}
+
+function abrirValidacao() {
+  if (selecionada.value && acoes.value.validar) validando.value = true
+}
+
+const MENSAGENS_BLOQUEIO: Record<ErroValidacao['tipo'], { titulo: string; texto: string }> = {
+  JA_RESPONDIDA: { titulo: 'Ordem j├í respondida', texto: 'Outro participante j├í registrou a valida├º├úo. A decis├úo atual est├í exibida e n├úo pode ser substitu├¡da.' },
+  STATUS_INVALIDO: { titulo: 'A├º├úo indispon├¡vel', texto: 'Esta ordem n├úo est├í mais aguardando valida├º├úo.' },
+  SEM_PERMISSAO: { titulo: 'Sem permiss├úo', texto: 'Somente o solicitante ou um participante vinculado pode validar esta ordem.' },
+  GENERICO: { titulo: 'Erro', texto: 'N├úo foi poss├¡vel registrar a valida├º├úo. Tente novamente.' },
+}
+
+// CA3/CA4: a├º├úo bloqueada. Fecha o modal, sincroniza a tela e mostra o resultado atual.
+async function tratarBloqueio(alvo: OrdemPortal, erroValidacao: ErroValidacao) {
+  validando.value = false
+  await carregar()
+  await carregarHistorico(alvo.id_ordem_servico)
+  if (erroValidacao.tipo === 'JA_RESPONDIDA') {
+    validacao.value = erroValidacao.validacao ?? (await buscarValidacao(alvo.id_ordem_servico))
+  }
+  const { titulo, texto } = MENSAGENS_BLOQUEIO[erroValidacao.tipo]
+  await Swal.fire({ title: titulo, text: erroValidacao.tipo === 'GENERICO' ? erroValidacao.mensagem || texto : texto, icon: erroValidacao.tipo === 'GENERICO' ? 'error' : 'info', confirmButtonColor: '#2563eb' })
+}
+
+async function confirmarValidacao(resultado: ResultadoValidacao) {
+  const alvo = selecionada.value
+  if (!alvo) return
+  enviando.value = true
+  try {
+    // CA3: confere o status mais recente antes de enviar (outro participante pode ter respondido).
+    const atual = await buscarOrdem(alvo.id_ordem_servico)
+    if (atual.status_ordem_servico !== 'AGUARDANDO_VALIDACAO') {
+      const registrada = await buscarValidacao(alvo.id_ordem_servico)
+      await tratarBloqueio(alvo, registrada
+        ? { tipo: 'JA_RESPONDIDA', mensagem: '', validacao: registrada }
+        : { tipo: 'STATUS_INVALIDO', mensagem: '' })
+      return
+    }
+
+    const resposta = await validarOrdem(alvo.id_ordem_servico, resultado)
+    validando.value = false
+    await carregar()
+    await carregarHistorico(alvo.id_ordem_servico)
+    validacao.value = resposta.validacao ?? (await buscarValidacao(alvo.id_ordem_servico))
+
+    if (resultado.aprovada) {
+      irParaAvaliacao(alvo.id_ordem_servico) // CA1
+    } else {
+      await Swal.fire({ title: 'Servi├ºo reprovado', text: 'A ordem retornou ao t├®cnico respons├ível e o gestor foi alertado.', icon: 'success', timer: 3000, showConfirmButton: false })
+    }
+  } catch (e) {
+    if (e instanceof ValidacaoError) await tratarBloqueio(alvo, e.info)
+    else {
+      console.error('Erro na valida├º├úo', e)
+      Swal.fire({ title: 'Erro', text: 'N├úo foi poss├¡vel registrar a valida├º├úo. Tente novamente.', icon: 'error' })
+    }
+  } finally {
+    enviando.value = false
+  }
+}
+
+// US08/CA1: a avalia├º├úo ├® obrigat├│ria antes do encerramento da ordem.
+function irParaAvaliacao(id: number) {
+  router.push({ name: 'avaliacao-os', params: { id } })
+}
+
+function emBreve(nome: string) {
+  Swal.fire({ title: nome, text: 'Esta funcionalidade estar├í dispon├¡vel em breve.', icon: 'info', confirmButtonColor: '#2563eb' })
+}
+
+onMounted(() => {
+  carregar(true)
+  timer = setInterval(() => carregar(), INTERVALO_ATUALIZACAO_MS)
