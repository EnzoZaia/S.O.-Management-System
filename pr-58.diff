+  EM_EXECUCAO: {
+    rotulo: 'Em atendimento',
+    descricao: 'Um t├®cnico est├í executando o servi├ºo.',
+    icone: '­ƒöº',
+    classes: 'bg-amber-100 text-amber-700 border-amber-200',
